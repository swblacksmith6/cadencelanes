# Copy to .env (git-ignored) and fill in. Used by docker-compose.prod.yml.

# Required. At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Required. MSG91 API auth key.
MSG91_AUTH_KEY=
# Required. MSG91 template ID of the DLT-approved OTP template.
# The template variables must be named ##var1## (OTP), ##var2## (app name), ##var3## (minutes).
MSG91_OTP_TEMPLATE_ID=

# Value for the app-name slot of the SMS. Default: CadenceLanes
SMS_APP_NAME=CadenceLanes

# Super admin login phone (10 digits, must be able to receive SMS). Default: 9999999999
SUPER_ADMIN_PHONE=

# Comma-separated allowed browser origins, e.g. https://app.example.com
CORS_ORIGINS=

# Host port for docker-compose.local-prod.yml only. Default: 8080
PORT=8080