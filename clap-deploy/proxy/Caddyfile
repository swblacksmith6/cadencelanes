(secure) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	request_body {
		max_size 10MB
	}
}

cl.lusidlogix.com {
	import secure
	reverse_proxy cadencelanes:8000
}
