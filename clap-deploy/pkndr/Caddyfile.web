{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy pkndr-api:8000 {
			# WebSocket trips can idle; do not cut them early.
			stream_timeout 24h
			stream_close_delay 5s
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@sw path /sw.js /registerSW.js /index.html /manifest.webmanifest
		header @sw Cache-Control "no-cache"
	}
}
